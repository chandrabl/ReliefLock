NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string — create a free cluster at mongodb.com/atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/relieflock

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

STELLAR_NETWORK=TESTNET
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Filled in after `stellar contract deploy` (see contracts/relieflock-contract/README.md)
CONTRACT_ID=

# Optional: create a project at sentry.io and paste the DSN to enable error tracking
SENTRY_DSN=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
